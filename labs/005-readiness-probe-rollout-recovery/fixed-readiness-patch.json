{
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "nginx",
            "readinessProbe": {
              "httpGet": {
                "path": "/",
                "port": 80
              },
              "initialDelaySeconds": 3,
              "periodSeconds": 5
            }
          }
        ]
      }
    }
  }
}
